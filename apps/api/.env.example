NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/eduflux?retryWrites=true&w=majority
FIREBASE_PROJECT_ID=eduflux-b576b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CSRF_SECRET=replace-with-another-32-random-characters
FIREBASE_SESSION_TTL_DAYS=7
TRUST_PROXY_HOPS=0
MONGODB_MAX_POOL_SIZE=10
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eduflux
R2_PRESIGN_TTL_SECONDS=300
SUBMISSION_MAX_FILES=5
SUBMISSION_MAX_FILE_BYTES=15728640
SUBMISSION_MAX_TOTAL_BYTES=52428800
AI_PROVIDER=openrouter
AI_API_KEY=
# Preferred when AI_PROVIDER=openrouter; AI_API_KEY remains a backwards-compatible fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_RUBRIC_MODEL=openai/gpt-4.1-mini
AI_EVALUATION_MODEL=openai/gpt-4.1-mini
OCR_PROVIDER=google-vision
GOOGLE_APPLICATION_CREDENTIALS=D:/absolute/path/to/vision_key.json
OCR_LANGUAGE_HINTS=en
OCR_ENABLE_HANDWRITING=true
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=20000
