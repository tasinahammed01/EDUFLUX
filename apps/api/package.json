{
  "name": "@eduflux/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:indexes": "tsx src/scripts/create-indexes.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e:server": "tsx src/test/e2e-server.ts"
  },
  "dependencies": {
    "@eduflux/config": "workspace:*",
    "@eduflux/shared-types": "workspace:*",
    "@eduflux/validation": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase-admin": "14.4.0",
    "helmet": "8.3.0",
    "mongoose": "9.10.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "11.2.0",
    "supertest": "7.1.4",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
